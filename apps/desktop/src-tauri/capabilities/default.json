{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "메인 창 기본 권한: 핵심 API, 파일 대화상자, 업데이트 확인·설치 후 재시작, 웹 링크 열기, 저장한 파일을 폴더에서 보기만 허용함",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "updater:default",
    "process:allow-restart",
    "opener:allow-open-url",
    "opener:allow-reveal-item-in-dir"
  ]
}
