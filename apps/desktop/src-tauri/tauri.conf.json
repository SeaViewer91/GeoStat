{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GeoStat",
  "version": "0.9.2",
  "identifier": "io.github.seaviewer91.geostat",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GeoStat",
        "width": 1280,
        "height": 820,
        "minWidth": 800,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* https://tiles.openfreemap.org; img-src 'self' data: blob: https://tiles.openfreemap.org; style-src 'self' 'unsafe-inline'; script-src 'self' blob:; worker-src 'self' blob:; child-src blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "public.app-category.education",
    "shortDescription": "공간통계 분석 데스크톱 앱",
    "copyright": "Copyright © 2026 Suho Bak. MIT License.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZFODYwOUJCREYyMjg2NTQKUldSVWhpTGZ1d21HL2xhRklrVDk2bU5hby9ZaUhvTlJreXN5MnRXbnBld0tCTHkya1oyVElsOEwK",
      "endpoints": [
        "https://github.com/SeaViewer91/GeoStat/releases/latest/download/latest.json"
      ]
    }
  }
}
